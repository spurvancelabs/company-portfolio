{
  "name": "spurvance-labs-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:web": "cd apps/web && pnpm dev",
    "build:web": "cd apps/web && pnpm build",
    "deploy:web": "bash scripts/deploy-web.sh",
    "deploy:api": "bash scripts/deploy-api.sh",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}